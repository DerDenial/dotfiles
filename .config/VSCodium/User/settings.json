    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#bdbec2",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted",
                    "constant.other.symbol"
                ],
                "settings": {
                    "foreground": "#70cc92"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language",
                    "constant.character"
                ],
                "settings": {
                    "foreground": "#ccba4d"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage",
                    "storage.type",
                    "keyword.control"
                ],
                "settings": {
                    "foreground": "#adc0dc"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function",
                    "meta.function-call"
                ],
                "settings": {
                    "foreground": "#a1b8d6"
                }
            },
            {
                "scope": [
                    "entity.name.type",
                    "entity.name.class",
                    "support.type",
                    "support.class"
                ],
                "settings": {
                    "foreground": "#91baff"
                }
            },
            {
                "scope": [
                    "variable",
                    "variable.parameter",
                    "meta.definition.variable"
                ],
                "settings": {
                    "foreground": "#e5e5e9"
                }
            },
            {
                "scope": [
                    "entity.name.tag",
                    "entity.other.attribute-name"
                ],
                "settings": {
                    "foreground": "#ff9ea5"
                }
            },
            {
                "scope": [
                    "invalid",
                    "invalid.illegal"
                ],
                "settings": {
                    "foreground": "#f3f3f8",
                    "background": "#850e29"
                }
            },
            {
                "scope": [
                    "markup.heading",
                    "entity.name.section"
                ],
                "settings": {
                    "foreground": "#a1b8d6",
                    "fontStyle": "bold"
                }
            }
        ]
    },
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "comment": "#bdbec2",
            "string": "#70cc92",
            "number": "#ccba4d",
            "keyword": "#adc0dc",
            "function": "#a1b8d6",
            "method": "#a1b8d6",
            "class": "#91baff",
            "interface": "#91baff",
            "type": "#91baff",
            "enum": "#ccba4d",
            "namespace": "#adc0dc",
            "parameter": "#ffa364",
            "variable": "#e5e5e9",
            "property": "#91baff",
            "operator": "#f3f3f8",
            "decorator": "#ffa364"
        }
    }
}
